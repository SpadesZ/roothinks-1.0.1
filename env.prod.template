# Roothinks production environment template
# Copy to env.prod and fill real secrets.

FLASK_ENV=production
FLASK_DEBUG=0
PORT=10000

# Security
SECRET_KEY=CHANGE_ME_STRONG_SECRET
FERNET_KEY=CHANGE_ME_VALID_FERNET_KEY
API_AUTH_ENABLED=1
API_BEARER_TOKENS=CHANGE_ME_TOKEN_1,CHANGE_ME_TOKEN_2
TOKEN_ACL_MAP_JSON={"CHANGE_ME_TOKEN_1":{"tenant_id":"default","access_level":"internal","allowed_pids":["*"]}}
CORS_ALLOWED_ORIGINS=https://your-domain.example

# Infra
# Use authenticated Redis URI in production.
# If Redis is only inside private network, redis:// with password is acceptable;
# across untrusted network prefer rediss://.
SOCKETIO_MESSAGE_QUEUE=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/1
RATELIMIT_STORAGE_URI=redis://:CHANGE_ME_REDIS_PASSWORD@redis:6379/0
LOCK_ROOT=/tmp/roothinks-locks

# DB pool (SQLite transitional-safe defaults; for PostgreSQL you can increase)
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=4
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT_SEC=30

# Gunicorn profile
GUNICORN_WORKERS=2
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=300
GUNICORN_GRACEFUL_TIMEOUT=60
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_KEEPALIVE=5

# Workload control
LITERATURE_MAX_WORKERS=1

# Equation LaTeX OCR engine chain
# llm: task_4cv -> tesseract fallback
# unimernet: unimernet(cmd/task) -> task_4cv -> tesseract fallback
# auto: unimernet(cmd/task) -> task_4cv -> tesseract fallback
LITERATURE_LATEX_ENGINE=llm
LITERATURE_LATEX_OCR_ENABLE=true
LITERATURE_LATEX_TASK_ID=task_4cv
LITERATURE_LATEX_ACCEPT_THRESHOLD=0.55
LITERATURE_LATEX_MAX_RETRIES=1

# UniMERNet hook (optional)
# If LITERATURE_UNIMERNET_CMD is set, it should print JSON to stdout.
# Supports placeholders: {image}, {seq_id}, {page}, {bbox}, {page_w}, {page_h}
LITERATURE_UNIMERNET_CMD=
LITERATURE_UNIMERNET_TASK_ID=
LITERATURE_UNIMERNET_ACCEPT_THRESHOLD=0.45
LITERATURE_UNIMERNET_MAX_RETRIES=0
LITERATURE_UNIMERNET_TIMEOUT_SEC=45

# Literature conversational paper finder (A/B/C scouts)
# task_3b_scout / task_3c_scout MUST be bound to Gemini connections:
# Google Search grounding is Gemini-only; Gemma cannot use tools at all.
LIT_CHAT_SCOUT_LIMIT=10
LIT_CHAT_MAX_PAPERS=20
LIT_CHAT_CACHE_TTL_SEC=21600
# Grounded search is the only stage that waits on external search round-trips.
# Measured: gemini-flash-latest ~90s for 9 search queries; pro-tier models get
# killed at 75s. Bind the scout roles to flash-tier Gemini models.
LIT_CHAT_SEARCH_TIMEOUT_SEC=150
LIT_CHAT_STAGE_TIMEOUT_SEC=60
# Overall gate: per-stage limits sum past gunicorn --timeout (300s), so later
# stages only get what the earlier ones left. ~90s reserved for the A compose.
LIT_CHAT_TOTAL_BUDGET_SEC=210

# Surya equation-only internal development flags (disabled by default)
VNS_SURYA_EQ_ENABLE=0
VNS_SURYA_EQ_HINT_FILE=
VNS_SURYA_EQ_CONF_THRESHOLD=0.62
VNS_SURYA_EQ_MERGE_IOU=0.38
VNS_SURYA_EQ_MAX_HINTS_PER_PAGE=12
