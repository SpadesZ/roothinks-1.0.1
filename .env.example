# 檔案路徑: .env.example
# 產生時間: 2026-07-04 18:55 +08:00
# 版本: v0.1
# Note: Example only. Do not commit real secrets.

APP_ENV=local
DATABASE_URL=sqlite:///./instance/roothinks.db
SECRET_KEY=change-me
FERNET_KEY=

LLM_PROVIDER=
LLM_API_KEY=
LLM_RESPONSE_CACHE_ENABLED=false

CONTEXT_CHAIN_L2_MAX_PACKETS=8

# Literature 對話式找文獻（A/B/C 三腳）
# 每隻搜尋腳最多提幾篇（論文在質不在量，調高只會讓回查變慢）
LIT_CHAT_SCOUT_LIMIT=10
# 合併驗證後回給前端的上限
LIT_CHAT_MAX_PAPERS=20
# 同一個查詢的結果快取秒數；預設 6 小時，避免重複燒 grounding 額度
LIT_CHAT_CACHE_TTL_SEC=21600
# grounded 檢索的時限。實測 gemini-flash-latest 跑 9 條搜尋查詢約 90s，
# pro 級模型在 75s 內跑不完會被砍掉（scout 角色建議一律用 flash）
LIT_CHAT_SEARCH_TIMEOUT_SEC=150
# 互檢與回查的時限（兩者都不開 grounding，本來就快）
LIT_CHAT_STAGE_TIMEOUT_SEC=60
# 整輪搜尋的總預算；gunicorn --timeout 是 300s，要留約 90s 給 A 組稿
LIT_CHAT_TOTAL_BUDGET_SEC=210
