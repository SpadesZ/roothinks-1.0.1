  "i11_record_corrections": [
    {
      "claim": "I11 證據寫 cdn.plot.ly plotly「未被這兩條流程請求」",
      "measured": "錯誤。實測兩條流程都請求 https://cdn.plot.ly/plotly-2.27.0.min.js 並失敗（net::ERR_TUNNEL_CONNECTION_FAILED），科學流程 5 次、自主性流程 16 次。",
      "root_cause": "I11 的包裝只記錄「被導流的請求」，未記錄未導流與失敗的請求，因此外部主機的失敗在證據裡消失。_header.html 無條件載入 plotly，而 manuscript_workspace.html 用的是 _navbar.html，才造成誤判。",
      "fix": "I12 包裝改為記錄每一個外部請求、每一次 requestfailed 與 console 錯誤。"
    },
    {
      "claim": "I11 證據完全沒有提到 accounts.google.com",
      "measured": "manuscript_workspace.html:640 載入 https://accounts.google.com/gsi/client，該主機在本容器**可達且載入成功**（curl 200，瀏覽器無 requestfailed）。",
      "root_cause": "同上：未記錄非導流請求，所以第四個外部網域從未出現在證據裡。",
      "fix": "已納入 I12 的外部請求清單；Google Drive OAuth 本身依 Owner 決策未執行。"
    },
    {
      "claim": "I11 證據寫 KaTeX 與 Split.js「未被這兩條流程請求」",
      "measured": "正確。兩者只在 study.html，而 I11 的兩條流程未造訪該頁。I12 已新增流程涵蓋。",
      "root_cause": null,
      "fix": null
    }
  ],
